# Telegram Bot API configuration
# Obtain the token via @BotFather as described in the official docs:
# https://core.telegram.org/bots#6-botfather
TELEGRAM_BOT_TOKEN=YOUR_BOT_TOKEN_HERE

# Optional comma-separated list of administrator user IDs allowed to manage the bot
ADMIN_IDS=123456789

# Web API port used by the aiohttp application
API_PORT=8080

# Optional proxy and timeout overrides for regions where Telegram is blocked
# TELEGRAM_PROXY_URL=https://user:password@proxy.example.org:443
# TELEGRAM_READ_TIMEOUT=30
# TELEGRAM_WRITE_TIMEOUT=30
# TELEGRAM_CONNECT_TIMEOUT=10
# TELEGRAM_POOL_TIMEOUT=5
